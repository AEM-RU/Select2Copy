<Window x:Class="Select2Copy.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Select2Copy"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#4FD1C5" />
        <SolidColorBrush x:Key="Muted" Color="#8A94A6" />

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E2228" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Background="#3D4450"
                                CornerRadius="10"
                                BorderBrush="#4DFFFFFF"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3BB8AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#252B33" />
                                <Setter Property="Foreground" Value="Gray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="Background" Value="#2A303C" />
        </Style>

        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A303C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2141619"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="2"
            CornerRadius="10"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="НАСТРОЙКИ"
                           Foreground="{StaticResource Accent}"
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CloseText"
                           Text="✕"
                           Foreground="Gray"
                           FontSize="15"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseLeftButtonDown="CloseText_MouseLeftButtonDown" />
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Запуск вместе с Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Автоматический запуск при старте системы" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <CheckBox x:Name="AutostartCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center"
                                  Click="Setting_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Звуковой сигнал" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Звук при успешном копировании" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <CheckBox x:Name="SoundCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center"
                                  Click="Setting_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Всплывающая подсказка" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Показывать «Скопировано!» возле курсора" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <CheckBox x:Name="TipCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center"
                                  Click="Setting_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Двойной клик" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Копировать текст при двойном клике мышью" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <CheckBox x:Name="DoubleClickCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center"
                                  Click="Setting_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="История" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Сохранять последние пять скопированных текстов" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <CheckBox x:Name="HistoryCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center"
                                  Click="History_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Последовательная вставка" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="После Ctrl + V подставлять следующий текст из истории" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <CheckBox x:Name="SequentialCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource Toggle}"
                                  VerticalAlignment="Center"
                                  Click="Setting_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Горячая клавиша" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Включение и отключение Select2Copy" Style="{StaticResource RowSub}" />
                        </StackPanel>
                        <Button x:Name="HotkeyButton"
                                Grid.Column="1"
                                Content="Ctrl + F2"
                                MinWidth="120"
                                Style="{StaticResource SecondaryButton}"
                                Click="HotkeyButton_Click" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Исключения" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Приложения, в которых копирование отключено" Style="{StaticResource RowSub}" />
                        <Border Background="#141619"
                                CornerRadius="6"
                                BorderBrush="#33808080"
                                BorderThickness="1"
                                Height="108"
                                Margin="0,8,0,8">
                            <ListBox x:Name="ExcludedList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontFamily="Segoe UI"
                                     FontSize="11"
                                     ItemContainerStyle="{StaticResource ListItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ДОБАВИТЬ"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="90"
                                    Margin="0,0,8,0"
                                    Click="AddExclusion_Click" />
                            <Button Content="УДАЛИТЬ"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="90"
                                    Click="RemoveExclusion_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="HintText"
                           Foreground="#EBCB8B"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,2,2,8" />

                <Grid Margin="0,2,0,0">
                    <Button Content="ОЧИСТИТЬ ИСТОРИЮ"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Click="ClearHistory_Click" />
                    <TextBlock Text="Select2Copy 1.0.0"
                               Foreground="{StaticResource Muted}"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
