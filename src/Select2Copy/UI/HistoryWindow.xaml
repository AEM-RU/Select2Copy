<Window x:Class="Select2Copy.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История Select2Copy"
        Width="300"
        SizeToContent="Height"
        MaxHeight="470"
        WindowStartupLocation="Manual"
        Topmost="True"
        Focusable="True"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="HistoryItem" TargetType="Border">
            <Setter Property="Background" Value="#CC1E2228" />
            <Setter Property="BorderBrush" Value="#33808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4FD1C5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1E2228" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#4FD1C5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="MaxWidth" Value="300" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   MaxWidth="280"
                                   Foreground="White"
                                   FontFamily="Segoe UI"
                                   FontSize="11" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F2141619"
            BorderBrush="#4FD1C5"
            BorderThickness="2"
            CornerRadius="8"
            Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="ИСТОРИЯ"
                           Foreground="#4FD1C5"
                           FontSize="15"
                           FontWeight="Bold"
                           FontFamily="Segoe UI" />
                <TextBlock x:Name="CloseText"
                           Text="✕"
                           Foreground="Gray"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Cursor="Hand"
                           MouseLeftButtonDown="CloseText_MouseLeftButtonDown" />
            </Grid>
            <ScrollViewer MaxHeight="380"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Items" />
            </ScrollViewer>
            <TextBlock x:Name="Empty"
                       Text="История пуста"
                       Foreground="Gray"
                       FontSize="11"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,4"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
