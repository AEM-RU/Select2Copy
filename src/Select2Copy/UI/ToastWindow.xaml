<Window x:Class="Select2Copy.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select2Copy"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize">
    <Border Background="#E6141619"
            BorderBrush="#4FD1C5"
            BorderThickness="1.5"
            CornerRadius="6"
            Padding="9,4"
            Margin="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="Black" />
        </Border.Effect>
        <TextBlock x:Name="MessageText"
                   Text="Скопировано!"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="White"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
    </Border>
</Window>
