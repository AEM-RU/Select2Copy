<Window x:Class="Select2Copy.UI.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить исключение"
        Width="330"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#4FD1C5" />
        <SolidColorBrush x:Key="Muted" Color="#8A94A6" />
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#4FD1C5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3BB8AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#252B33" />
                                <Setter Property="Foreground" Value="Gray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#2A303C" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A303C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4FD1C5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F2141619"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="16"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <TextBlock Text="ДОБАВИТЬ ИСКЛЮЧЕНИЕ"
                           Foreground="{StaticResource Accent}"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="Bold" />
                <TextBlock x:Name="CloseText"
                           Text="✕"
                           Foreground="Gray"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Cursor="Hand"
                           MouseLeftButtonDown="CloseText_MouseLeftButtonDown" />
            </Grid>

            <TextBlock Text="Имя процесса (например, notepad):"
                       Foreground="{StaticResource Muted}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#1E2228"
                        CornerRadius="6"
                        BorderBrush="#33808080"
                        BorderThickness="1"
                        Padding="7,5">
                    <TextBox x:Name="NameBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             CaretBrush="{StaticResource Accent}"
                             FontFamily="Segoe UI"
                             FontSize="12"
                             VerticalAlignment="Center"
                             KeyDown="NameBox_KeyDown" />
                </Border>
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        Content="ОБЗОР"
                        Width="70"
                        Margin="6,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="Browse_Click" />
            </Grid>

            <TextBlock Text="Или выберите из запущенных приложений:"
                       Foreground="{StaticResource Muted}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,6" />
            <Border Background="#1E2228"
                    CornerRadius="6"
                    BorderBrush="#33808080"
                    BorderThickness="1"
                    Height="120"
                    Margin="0,0,0,14">
                <ListBox x:Name="AppsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontFamily="Segoe UI"
                         FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="AppsList_SelectionChanged"
                         MouseDoubleClick="AppsList_MouseDoubleClick" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="ОТМЕНА"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="ДОБАВИТЬ"
                        Style="{StaticResource DialogButton}"
                        Click="Add_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
